{
  "name": "@amsterdam/amsterdam-react-maps",
  "private": true,
  "workspaces": [
    "packages/*",
    "stories"
  ],
  "scripts": {
    "start": "npm run start --workspace=stories",
    "lint": "eslint ./ --ext ts,tsx",
    "build:clean": "find ./packages -name \"*.d.ts\" -type f -delete && find ./packages -name \"*.tsbuildinfo\" -type f -delete",
    "build": "npm run build:clean && npm run build:ts && npm run build:ts:es",
    "build:storybook": "npm run build --workspace=stories",
    "build:ts": "ttsc -b packages/arm-core packages/arm-cluster packages/arm-nontiled",
    "build:ts:es": "ttsc -b packages/arm-core/tsconfig.es.json packages/arm-cluster/tsconfig.es.json packages/arm-nontiled/tsconfig.es.json",
    "build:netlify": "npm run build && npm run build:storybook",
    "test": "jest",
    "test:watch": "jest --watch --onlyChanged",
    "publish:canary": "npm run build && lerna publish --canary --yes",
    "publish:stable": "npm run build && lerna publish"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "leaflet.nontiledlayer": "^1.0.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@amsterdam/asc-assets": "^0.38.0",
    "@amsterdam/asc-ui": "^0.38.0",
    "@babel/core": "^7.10.2",
    "@babel/preset-env": "^7.10.2",
    "@babel/preset-react": "^7.10.1",
    "@babel/preset-typescript": "^7.10.1",
    "@svgr/webpack": "^6.1.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.3.0",
    "@types/jest": "^29.5.12",
    "@types/leaflet": "^1.9.9",
    "@types/leaflet-draw": "^1.0.11",
    "@types/leaflet.markercluster": "^1.4.2",
    "@types/node": "^20.12.7",
    "@types/proj4": "^2.5.0",
    "@types/proj4leaflet": "^1.0.5",
    "@types/react": "^18.2.75",
    "@types/react-dom": "^18.2.24",
    "@types/react-router-dom": "^5.1.5",
    "@types/styled-components": "^5.1.4",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^7.6.0",
    "@typescript-eslint/parser": "^7.6.0",
    "contains-path": "^1.0.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-mdx": "^2.0.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.27.1",
    "eslint-plugin-react-hooks": "^4.3.0",
    "geojson": "^0.5.0",
    "gh-pages": "^5.0.0",
    "jest": "^29.7.0",
    "jest-cli": "^29.0.1",
    "jest-environment-jsdom": "^29.7.0",
    "jest-mocked": "^0.0.0",
    "jest-styled-components": "^7.0.4",
    "lerna": "^8.1.2",
    "node-modules-regexp": "^1.0.0",
    "prettier": "^2.5.1",
    "styled-components": "^5.1.1",
    "ts-jest": "^29.1.2",
    "ttypescript": "^1.5.10",
    "typescript": "^4.0.5",
    "typescript-plugin-styled-components": "^2.0.0"
  }
}
